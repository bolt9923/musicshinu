# ══════════════════════════════════════════════════════════
#  Shinu Music Bot — Environment Variables
#  Copy this to .env for local dev. On Heroku, set via:
#    heroku config:set KEY=value
#  NEVER commit .env or real values to git!
# ══════════════════════════════════════════════════════════

# ── Required: Telegram ────────────────────────────────────
# From https://my.telegram.org/apps
API_ID=
API_HASH=

# From @BotFather on Telegram
BOT_TOKEN=

# Your Telegram numeric user ID (from @userinfobot)
OWNER_ID=423346191

# ── Required: Assistant session ───────────────────────────
# Run generate_session.py once to generate this
STRING_SESSION=

# ── Required: MongoDB ─────────────────────────────────────
# Free cluster at https://mongodb.com/atlas
# heroku config:set MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/shinubot"
MONGO_URI=

# ── Optional: YouTube Data API v3 ─────────────────────────
# Get from https://console.cloud.google.com → YouTube Data API v3
# heroku config:set YOUTUBE_API_KEY="AIzaSy..."
YOUTUBE_API_KEY=

# ── Optional: YouTube Cookies ─────────────────────────────
# Export cookies.txt from youtube.com using "Get cookies.txt" Chrome extension
# heroku config:set YOUTUBE_COOKIES="$(cat cookies.txt)"
YOUTUBE_COOKIES=

# ── Optional: Genius Lyrics ───────────────────────────────
# From https://genius.com/api-clients
GENIUS_TOKEN=

# ── Optional tweaks ───────────────────────────────────────
MAX_QUEUE_SIZE=50
